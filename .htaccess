<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. Clean up '/velora-ecommerce/' prefix if someone visits old bookmark or URL
    RewriteRule ^velora-ecommerce/(.*)$ /$1 [R=301,L]

    # 2. Route API requests: /api/* -> backend/api/*
    RewriteRule ^api/(.*)$ backend/api/$1 [L,QSA]

    # 3. Route root / directly to index.php which serves the Storefront UI
    RewriteRule ^$ index.php [L]

    # 4. If file exists in frontend/, serve it transparently
    RewriteCond %{DOCUMENT_ROOT}/frontend/$1 -f [OR]
    RewriteCond %{DOCUMENT_ROOT}/frontend/$1 -d
    RewriteRule ^(.*)$ frontend/$1 [L,QSA]

    # 5. Direct file match
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # 6. Fallback everything else through universal index.php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.php [L,QSA]
</IfModule>

# Prevent directory listing
Options -Indexes
